{
  "description": "Real keys: Enter and Escape outside a skip behave as without the mod, in dialogue and in exploration.",
  "save": "KMCS_AFTER_SKIPS.zks",
  "captureEveryFrames": 0,
  "steps": [
    {
      "op": "wait",
      "seconds": 1.0
    },
    {
      "op": "snapshot",
      "label": "exploration"
    },
    {
      "op": "markOperations",
      "label": "exploration-enter"
    },
    {
      "op": "pressKey",
      "key": "Return",
      "holdMs": 60
    },
    {
      "op": "wait",
      "seconds": 1.0
    },
    {
      "op": "expectNoSkip"
    },
    {
      "op": "pressKey",
      "key": "Escape",
      "holdMs": 60
    },
    {
      "op": "waitMode",
      "mode": "EscMode",
      "timeoutSeconds": 6
    },
    {
      "op": "pressKey",
      "key": "Escape",
      "holdMs": 60
    },
    {
      "op": "waitMode",
      "mode": "Default",
      "timeoutSeconds": 6
    },
    {
      "op": "snapshot",
      "label": "after-menu"
    }
  ]
}
